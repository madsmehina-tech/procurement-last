; =============================================================================
;  PO Web - settings file.   Copy this file to  config.ini  and edit the values.
;  Lines starting with ; are comments. Paths may contain Arabic letters / spaces.
; =============================================================================

[database]
; Full path of the shared Access database (a LOCAL path on the server PC is best)
path = D:\PO System\PurchaseSystem.accdb

[storage]
; The archive root = a LOCAL folder on THIS (main) PC that you also share on the network.
; The system creates  الموردين\...  and  المقاولين\...  inside it automatically.
archive_root = D:\PO_Archive
; Old uploads folder from before the archive existed (read-only fallback). Optional.
legacy_uploads = D:\po_web\uploads
; How the OTHER PCs reach that same folder (shown in the app so the team can open it in Explorer)
share_path = \\SERVER\PO_Archive
max_upload_mb = 50
; Dated copies of the database: before every update of its structure AND automatically while the server runs.
backup_dir = E:\PO_Backup\db
backup_keep = 20
; An automatic copy every N hours (0 = off). The first copy is taken when the server starts.
backup_auto_hours = 12
; THE MOST IMPORTANT SETTING: a SECOND place for every copy - another disk, another PC's shared folder, or a OneDrive folder.
; A copy on the same disk as the database is not a real backup. (A comment after the value, like this one, is allowed.)
backup_extra_dir = \\BACKUPSERVER\PO_Backup
; The ARCHIVE FILES in the same backup (v27.6): a folder on ANOTHER disk / PC. It receives db\ (dated database copies), archive\ (a mirror: only new / changed
; files are copied, nothing is ever deleted) and manifests\ (what each backup contained). Run deploy\backup_all.bat ONCE by hand first (the first copy of a big
; archive takes a while), then the server keeps it up to date every backup_auto_hours.
; backup_archive_dir = F:\PO_BackupSet

[server]
host = 0.0.0.0
port = 5000
threads = 8
log_dir = D:\po_web\logs
session_hours = 12

[ocr]
; Reading photos/scans of quotes. Install Tesseract (with Arabic) and, if it is not found automatically, write its full path:
; tesseract_path = C:\Program Files\Tesseract-OCR\tesseract.exe
language = ara+eng
mode = auto

[pdf]
; PDF of every purchase order is made with Microsoft Edge / Google Chrome (found automatically). Only if not found:
; browser_path = C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
mode = auto
